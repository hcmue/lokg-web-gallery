APP_ENV=development
# local = one local catalog.yaml; github = GitHub Contents API persistent storage
CATALOG_BACKEND=local
CATALOG_PATH=./data/catalog.yaml
# Set for deployment with CATALOG_BACKEND=github
GITHUB_REPOSITORY=hcmue/lokg-web-gallery
GITHUB_BRANCH=main
GITHUB_CATALOG_PATH=data/catalog.yaml
GITHUB_TOKEN=
ALLOWED_PAGE_HOSTS=hcmue.github.io
# Browser origin for public GET/POST only. Do not include the /lokg-web-gallery path.
PUBLIC_FRONTEND_ORIGIN=https://hcmue.github.io
ADMIN_PASSWORD=
SESSION_SECRET=

# Usage statistics: local SQLite for development; external PostgreSQL on Render Free.
ANALYTICS_ENABLED=true
DATABASE_URL=sqlite:///runtime_data/analytics.db
ANALYTICS_SECRET=REPLACE_WITH_PRIVATE_RANDOM_STRING_AT_LEAST_32_CHARACTERS
ANALYTICS_STORE_QUERIES=true
ANALYTICS_RETENTION_DAYS=90
# Only enable when using paid Render web service + persistent disk with SQLite.
ANALYTICS_ALLOW_SQLITE_PRODUCTION=false
